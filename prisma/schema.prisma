// Prisma schema for the video-dictation study platform.
// NOTE: status/mode fields use plain String (not Prisma enum) with values
// validated in lib/types.ts — a holdover from when this ran on SQLite
// (no native enum support there), kept for consistency now on Postgres.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  videos     Video[]
  answers    Answer[]
  documents  Document[]
  docAnswers DocAnswer[]

  @@map("users")
}

model Video {
  id               String   @id @default(uuid())
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title            String
  // one of: upload | youtube
  sourceType       String   @default("upload")
  originalFilename String?
  // upload only — null for sourceType="youtube"
  storageKey       String?
  mimeType         String?
  // youtube only — the 11-char video id, null for sourceType="upload"
  youtubeVideoId   String?
  durationSeconds  Float?
  // one of: uploading | transcribing | ready | failed
  status           String   @default("uploading")
  errorMessage     String?
  whisperModel     String?
  // one of: open | mcq — chosen at upload time, fixed for this video
  questionMode     String   @default("open")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  segments Segment[]

  @@index([ownerId])
  @@map("videos")
}

model Segment {
  id                 String   @id @default(uuid())
  videoId            String
  video              Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  orderIndex         Int
  startTime          Float
  endTime            Float
  transcriptText     String
  // LLM-generated question whose direct answer is transcriptText; null if
  // generation failed or hasn't run yet (UI falls back to a generic prompt).
  question           String?
  // mcq mode only: JSON-encoded array of 4 option strings, and the index
  // (0-3) of the option matching transcriptText.
  options            String?
  correctOptionIndex Int?
  createdAt          DateTime @default(now())

  answers Answer[]

  @@unique([videoId, orderIndex])
  @@index([videoId, startTime])
  @@map("segments")
}

model Answer {
  id                  String    @id @default(uuid())
  segmentId           String
  segment             Segment   @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  answerText          String?
  // mcq mode only: index (0-3) of the option the user picked
  selectedOptionIndex Int?
  skipped             Boolean   @default(false)
  submittedAt         DateTime?
  updatedAt           DateTime  @updatedAt

  @@unique([segmentId, userId])
  @@map("answers")
}

model Document {
  id               String   @id @default(uuid())
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title            String
  originalFilename String
  // v1 only supports "txt"; kept as a string for the same reason as
  // Video.status/questionMode — future formats (pdf, docx) add values here.
  sourceFormat     String   @default("txt")
  rawText          String
  // one of: processing | ready | failed
  status           String   @default("processing")
  errorMessage     String?
  // one of: open | mcq — chosen at upload time, fixed for this document
  questionMode     String   @default("open")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  fragments Fragment[]

  @@index([ownerId])
  @@map("documents")
}

model Fragment {
  id                 String   @id @default(uuid())
  documentId         String
  document           Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  orderIndex         Int
  // Always 1 for "txt" in v1 (plain text has no real page concept — see
  // docs/DEPLOYMENT.md and scripts/pending_features/text_document_questions.py
  // for the per-format page convention this will need once pdf/docx land).
  page               Int
  lineStart          Int
  lineEnd            Int
  text               String
  question           String?
  options            String?
  correctOptionIndex Int?
  createdAt          DateTime @default(now())

  answers DocAnswer[]

  @@unique([documentId, orderIndex])
  @@map("fragments")
}

model DocAnswer {
  id                  String    @id @default(uuid())
  fragmentId          String
  fragment            Fragment  @relation(fields: [fragmentId], references: [id], onDelete: Cascade)
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  answerText          String?
  selectedOptionIndex Int?
  skipped             Boolean   @default(false)
  submittedAt         DateTime?
  updatedAt           DateTime  @updatedAt

  @@unique([fragmentId, userId])
  @@map("doc_answers")
}
