// Prisma schema for the video-dictation study platform.
// NOTE: status/mode fields use plain String (not Prisma enum) with values
// validated in lib/types.ts — a holdover from when this ran on SQLite
// (no native enum support there), kept for consistency now on Postgres.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  // Billing (Stripe) — all nullable because the platform is free until the
  // global user-count tier kicks in (see lib/billing-tiers.ts); most users
  // will never have any of these set.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  // one of: active | trialing | past_due | canceled | incomplete |
  // incomplete_expired | unpaid — mirrors Stripe's subscription.status
  subscriptionStatus   String?
  // ARS cents Stripe is CURRENTLY charging this user — compared live
  // against getCurrentRequiredTierCents() to detect a stale price after
  // the global tier ticks up; kept separate from "is this user allowed to
  // write right now", which depends only on subscriptionStatus/grace.
  subscribedPriceCents Int?
  currentPeriodEnd     DateTime?
  // Set the first time this user is found liable-but-unsubscribed; starts
  // their individual grace window rather than a single platform-wide
  // "we crossed the threshold" timestamp.
  paymentGraceUntil    DateTime?

  videos     Video[]
  documents  Document[]
  docAnswers DocAnswer[]

  @@map("users")
}

// A video/audio "study sheet": a pasted transcript (with timestamps, from
// YouTube's own panel, TurboScribe, or similar) gets split into segments,
// each with an LLM-generated comprehension question. There's no dictation
// practice/answer-checking step here — the point is quick navigation, so
// each question links straight to the moment in the video/audio that
// answers it (see components/videos/VideoQAView.tsx).
model Video {
  id             String   @id @default(uuid())
  ownerId        String
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title          String
  // one of: upload | youtube
  sourceType     String   @default("youtube")
  // upload only — null for sourceType="youtube"
  storageKey     String?
  mimeType       String?
  // youtube only — the 11-char video id, null for sourceType="upload"
  youtubeVideoId String?
  // one of: ready | failed
  status         String   @default("ready")
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  segments Segment[]

  @@index([ownerId])
  @@map("videos")
}

model Segment {
  id             String   @id @default(uuid())
  videoId        String
  video          Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  orderIndex     Int
  startTime      Float
  endTime        Float
  transcriptText String
  // LLM-generated question whose direct answer is transcriptText; null if
  // generation failed (backfillMissingQuestions guarantees a generic
  // fallback instead, so this is null only for pre-existing rows).
  question       String?
  createdAt      DateTime @default(now())

  @@unique([videoId, orderIndex])
  @@index([videoId, startTime])
  @@map("segments")
}

model Document {
  id               String   @id @default(uuid())
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title            String
  originalFilename String
  // v1 only supports "txt"; kept as a string for the same reason as
  // Video.status/questionMode — future formats (pdf, docx) add values here.
  sourceFormat     String   @default("txt")
  rawText          String
  // one of: processing | ready | failed
  status           String   @default("processing")
  errorMessage     String?
  // one of: open | mcq — chosen at upload time, fixed for this document
  questionMode     String   @default("open")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  fragments Fragment[]

  @@index([ownerId])
  @@map("documents")
}

model Fragment {
  id                 String   @id @default(uuid())
  documentId         String
  document           Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  orderIndex         Int
  // Always 1 for "txt" in v1 (plain text has no real page concept — see
  // docs/DEPLOYMENT.md and scripts/pending_features/text_document_questions.py
  // for the per-format page convention this will need once pdf/docx land).
  page               Int
  lineStart          Int
  lineEnd            Int
  text               String
  question           String?
  options            String?
  correctOptionIndex Int?
  createdAt          DateTime @default(now())

  answers DocAnswer[]

  @@unique([documentId, orderIndex])
  @@map("fragments")
}

model DocAnswer {
  id                  String    @id @default(uuid())
  fragmentId          String
  fragment            Fragment  @relation(fields: [fragmentId], references: [id], onDelete: Cascade)
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  answerText          String?
  selectedOptionIndex Int?
  skipped             Boolean   @default(false)
  submittedAt         DateTime?
  updatedAt           DateTime  @updatedAt

  @@unique([fragmentId, userId])
  @@map("doc_answers")
}
